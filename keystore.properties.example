# Keepbell Local Release Signing Configuration Template
# -----------------------------------------------------
# To configure local release signing:
# 1. Copy this file to 'keystore.properties' in the repository root.
# 2. Fill in the values below with your local keystore details.
#
# SECURITY NOTICE:
# - 'keystore.properties' is untracked and gitignored. NEVER commit real credentials or keystore files.
# - In CI environments, provide these via environment variables instead:
#   KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD.
# - Relative paths for 'storeFile' are resolved from the repository root.

storeFile=secrets/release.keystore
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
